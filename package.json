{
  "name": "arkme",
  "version": "0.2.4",
  "private": true,
  "author": "Jotmo",
  "description": "A secure Electron desktop shell for DeepSeek Harness",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "build:test": "ARKME_RUNTIME_SERVICE_BASE_URL=https://jotmo.senguo.me pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node scripts/run-development.mjs",
    "run:prod": "node scripts/run-packaged-shell.mjs prod",
    "run:test": "node scripts/run-packaged-shell.mjs test",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:runtime:universal": "ARKME_RUNTIME_ARCH=x64 node scripts/prepare-runtime.mjs && ARKME_RUNTIME_ARCH=arm64 node scripts/prepare-runtime.mjs",
    "build:runtime:electron-harness": "node scripts/runtime/build-electron-harness.mjs",
    "build:windows-artifacts": "node scripts/build-windows-artifacts.mjs",
    "verify:packaged": "node scripts/packaged-smoke.mjs",
    "verify:mac-signature": "node scripts/verify-macos-signature.mjs",
    "pack": "pnpm run build && electron-builder --mac --universal --dir && node scripts/verify-macos-signature.mjs release/mac-universal/arkme.app",
    "pack:test": "node scripts/run-test-packaging.mjs",
    "dist": "pnpm run build && electron-builder --mac dmg zip --universal && node scripts/verify-macos-signature.mjs release/mac-universal/arkme.app && ARKME_PACKAGED_APP_ROOT=release/mac-universal/arkme.app node scripts/packaged-smoke.mjs --platform darwin",
    "dist:test:mac": "pnpm run build:test && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.test-config.cjs --mac dmg zip --universal --publish never --config.mac.forceCodeSigning=false && node scripts/packaged-smoke.mjs --platform darwin --app-root 'release-test-dynamic/mac-universal/arkme Test.app'",
    "dist:test:win": "pnpm run build:test && electron-builder --config electron-builder.test-config.cjs --win nsis zip --x64 --publish never && node scripts/packaged-smoke.mjs --platform win32 --app-root release-test-dynamic/win-unpacked",
    "dist:test:linux": "pnpm run build:test && electron-builder --config electron-builder.test-config.cjs --linux AppImage --x64 --publish never && node scripts/packaged-smoke.mjs --platform linux --app-root release-test-dynamic/linux-unpacked",
    "dist:win": "pnpm run build && pnpm run build:windows-artifacts && node scripts/packaged-smoke.mjs --platform win32",
    "dist:linux": "pnpm run build && electron-builder --linux AppImage --x64 --publish never && node scripts/packaged-smoke.mjs --platform linux"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "4.2.0",
    "@senguoyun/dsh-arkme": "catalog:production",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "@types/tar-stream": "3.1.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "com.senx.arkme.harness",
    "productName": "arkme",
    "protocols": [
      {
        "name": "Arkme Extension Share",
        "schemes": [
          "arkme"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist/preload.cjs",
      "node_modules/@arkme/macos-notification-permission/build/Release/*.node"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocationUsageDescription": "Arkme 仅在你开启位置记录后，将当前位置写入你发送的快记快照。",
        "NSLocationWhenInUseUsageDescription": "Arkme 仅在你开启位置记录后，将当前位置写入你发送的快记快照。"
      },
      "forceCodeSigning": true,
      "x64ArchFiles": "**/{*darwin-arm64*,*darwin-x64*}/**/*",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "forceCodeSigning": true,
      "signtoolOptions": {
        "certificateSha1": "00ADCF59ACCC45F4643B4A682E32620C206CE66B",
        "publisherName": "Senqisi (Wuhan) Technology Co., Ltd.",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://time.certum.pl"
      }
    },
    "nsis": {
      "oneClick": false,
      "include": "build/nsis-installer-ui.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ]
  },
  "dependencies": {
    "ali-oss": "6.23.0",
    "electron-updater": "^6.8.9",
    "koffi": "3.1.5",
    "semver": "7.8.5",
    "tar-stream": "3.1.7"
  },
  "optionalDependencies": {
    "@arkme/macos-notification-permission": "file:./native/macos-notification-permission"
  }
}
